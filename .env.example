DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional generation controls. The V6 experiment sets these from CLI.
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=2048
# Only enable this if the configured OpenAI-compatible endpoint supports seed.
# DEEPSEEK_SEED=42
# Optional: request JSON-object output for Agent Decision calls only.
# Enable only when the configured OpenAI-compatible endpoint supports it.
# DEEPSEEK_JSON_MODE=true
